{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanglasswatcher.game/contracts/v1/memory-summary.schema.json",
  "title": "MemorySummary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "residentId",
    "summary",
    "facts",
    "promises",
    "sourceEventIds"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "residentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "facts": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "promises": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "sourceEventIds": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      }
    }
  }
}
