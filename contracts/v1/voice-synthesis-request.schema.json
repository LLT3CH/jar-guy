{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanglasswatcher.game/contracts/v1/voice-synthesis-request.schema.json",
  "title": "VoiceSynthesisRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "text", "voiceId"],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "voiceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  }
}
